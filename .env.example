# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE WEB SDK PUBLIC CONFIGURATION (Project: terra-track-53004, Region: asia-south1)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="terra-track-53004"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# SERVER-SIDE HARDWARE DEVICE INGESTION AUTH (Separate from Municipal User Auth)
ESP32_DEVICE_API_KEY=""

# SERVER-SIDE BOOTSTRAP ADMIN EMAIL (Authoritative initial Admin account)
TERRA_BOOTSTRAP_ADMIN_EMAIL=""

# CENTRAL NODE.JS BACKEND BASE URL (Production Render HTTPS API)
VITE_BACKEND_API_URL="https://terra-track-api.onrender.com"
